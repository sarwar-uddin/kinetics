# Maintainer: Sarwar Uddin <91957745+sarwar-uddin@users.noreply.github.com>
pkgname=kinetics
pkgver=0.2.2
pkgrel=1
pkgdesc="Educational pharmacokinetics explorer: how a substance moves through the body"
arch=('any')
url="https://github.com/sarwar-uddin/kinetics"
license=('GPL-3.0-or-later')
depends=(
  'python'
  'pyside6'
  'python-numpy'
  'python-scipy'
  'qt6-declarative'
  'kirigami'
)
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('475a09fca9d20b35b6654012a1d8503ff4ccdc297b6a46358f452f55162b130c')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl

  local appid=io.github.sarwar_uddin.Kinetics
  install -Dm644 "data/$appid.desktop" \
    "$pkgdir/usr/share/applications/$appid.desktop"
  install -Dm644 "data/$appid.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/$appid.metainfo.xml"
  install -Dm644 "data/icons/$appid.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/$appid.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

check() {
  cd "$pkgname-$pkgver"
  python -m unittest discover -s tests -t .
}
